"use client";
import { useState } from "react";
import { ForumReceptionWorkstation } from "@/app/dashboard/accoglienza-forum-eventi/workstation";
import type { DutyOption } from "@/lib/reception/event-duties";
const option=(key:string,title:string,from:string,until:string):DutyOption=>({key,title,room:"Sala di prova",kind:key==="opening"||key==="closing"?"ceremony":"panel",availableFrom:from,availableUntil:until});
const choices=[
 option("opening","Inaugurazione","2026-10-25T13:30:00+01:00","2026-10-25T20:30:00+01:00"),
 option("11111111-1111-4111-8111-111111111111","Forum mattina","2026-10-26T07:30:00+01:00","2026-10-26T13:30:00+01:00"),
 option("22222222-2222-4222-8222-222222222222","Forum mattina ore 10","2026-10-26T07:30:00+01:00","2026-10-26T13:30:00+01:00"),
 option("33333333-3333-4333-8333-333333333333","Forum pomeriggio ore 17","2026-10-26T13:30:00+01:00","2026-10-26T20:30:00+01:00"),
 option("44444444-4444-4444-8444-444444444444","Forum martedì mattina","2026-10-27T07:30:00+01:00","2026-10-27T13:30:00+01:00"),
 option("closing","Cerimonia finale","2026-10-27T13:30:00+01:00","2026-10-28T00:00:00+01:00"),
];
const scenarios={early:"2026-10-26T07:29:59+01:00",monday:"2026-10-26T13:29:59+01:00",tuesday:"2026-10-27T13:29:59+01:00",sunday:"2026-10-25T13:29:59+01:00",ended:"2026-10-28T00:00:00+01:00"};
async function requestAction(){return {status:"ready",booked:20,entered:0};}
export default function Fixture(){
 const [scenario,setScenario]=useState<keyof typeof scenarios>("monday");
 return <main className="mx-auto grid max-w-3xl gap-4 p-4"><label>Scenario di prova<select value={scenario} onChange={e=>setScenario(e.target.value as keyof typeof scenarios)}>{Object.keys(scenarios).map(key=><option key={key}>{key}</option>)}</select></label><ForumReceptionWorkstation key={scenario} eventId="synthetic" choices={choices} canManage={false} serverNow={Date.parse(scenarios[scenario])} requestAction={requestAction}/></main>;
}
