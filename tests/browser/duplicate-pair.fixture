import { Suspense } from "react";
import { cookies } from "next/headers";
import { randomUUID } from "node:crypto";
import { DuplicateListProvider, DuplicateListCount } from "@/app/dashboard/participants/data-quality/list-state";
import { pairKey, type DuplicateMatch } from "@/lib/data-quality/duplicates";
import { OperationsDuplicatesTable } from "@/app/dashboard/operations-duplicates-table";
import { DuplicateReviewLoader } from "@/app/dashboard/participants/data-quality/review-loader";
import type { QualityPerson } from "@/lib/data-quality/data.server";
export default async function Page({ searchParams }: { searchParams: Promise<Record<string, string>> }) {
 const people = [1,2,3].map(i => ({ id: `00000000-0000-0000-0000-00000000000${i}`, registrationId: `00000000-0000-0000-0000-00000000000${i}`, participantId: `p${i}`, name: `Persona ${i}`, firstName: 'Persona', lastName: String(i), publicCode: `TEST-${i}`, email: `persona${i}@example.invalid`, children: [], tagIds: [], eventId: 'synthetic', eventTitle: 'Fixture', deletedAt: null, registrationStatus: 'submitted', birthDate: null, phone: null, country: null, city: null, authUserId: null, place: '', currentGroupId: null, currentGroupName: null, currentGroupStatus: null, currentServiceId: null, currentServiceStatus: null } satisfies QualityPerson));
 const dismissed = JSON.parse((await cookies()).get('synthetic-dismissed')?.value ?? '[]') as string[];
 const excluded = (await searchParams).duplicateShow === 'dismissed';
 const all: DuplicateMatch[] = [1,2].map(i => ({left:people[0].id,right:people[i].id,level:dismissed.includes(pairKey(people[0].id,people[i].id)) ? 'dismissed' : 'possible',signals:['Nome simile']}));
 const matches = all.filter(match => excluded ? match.level === 'dismissed' : match.level !== 'dismissed');
 return <main className="p-6"><h1>Verifica duplicati — dati fittizi</h1>
  <DuplicateListProvider key={randomUUID()} pendingPairs={matches.filter(match => match.level !== 'dismissed').map(match => pairKey(match.left,match.right))}>
   <p>Da verificare (<DuplicateListCount value={all.filter(match=>match.level!=='dismissed').length} />)</p>
   <p>Esclusi (<DuplicateListCount value={dismissed.length} excluded />)</p>
   <h2>Possibili duplicati (<DuplicateListCount value={matches.length} excluded={excluded} label />)</h2>
   <OperationsDuplicatesTable people={people} matches={matches} forumActivity={new Map()} basePath="/duplicate-pair-check?section=iscritti&view=duplicates&duplicatePage=2" canWrite />
   <Suspense><DuplicateReviewLoader dashboard="manager" /></Suspense>
  </DuplicateListProvider>
 </main>;
}
