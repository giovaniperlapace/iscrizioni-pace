{
  "name": "iscrizioni-pace",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:staging": "npm run staging:verify && node scripts/run-next-staging.mjs dev",
    "build": "next build",
    "build:staging": "npm run staging:verify && node scripts/run-next-staging.mjs build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mts",
    "typecheck": "tsc --noEmit",
    "performance:http": "node scripts/benchmark-http.mjs",
    "db:migrate:staging": "scripts/apply-remote-migration.sh staging",
    "db:migrate:production": "scripts/apply-remote-migration.sh production",
    "bootstrap:test-users": "node scripts/bootstrap-test-users.mjs",
    "bootstrap:group-leaders": "node --env-file=.env.local scripts/bootstrap-group-leaders.mjs",
    "email:verify": "node --env-file=.env.local scripts/verify-email-config.mjs",
    "opening:verify": "node --env-file=.env.local scripts/verify-opening-readiness.mjs",
    "opening:verify:production": "node --env-file=.env.production.local scripts/verify-opening-readiness.mjs --production",
    "staging:sync-env": "node --env-file=.env.local scripts/sync-staging-env.mjs",
    "staging:verify": "node --env-file=.env.staging.local scripts/verify-staging-readiness.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-underline": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "lucide-react": "^1.20.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
