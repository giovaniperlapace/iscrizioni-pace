# Questo file documenta lo staging. Copiarlo in `.env.staging.local` e
# inserire soltanto credenziali dello stack Supabase di staging.
DEPLOYMENT_ENVIRONMENT=staging

NEXT_PUBLIC_SUPABASE_URL=https://supabase-staging.example.org
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://supabase-staging.example.org
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
QR_TOKEN_ENCRYPTION_SECRET=

NEXT_PUBLIC_APP_URL=https://staging.example.org
APP_URL=https://staging.example.org
PUBLIC_SITE_URL=https://staging.example.org

# In staging le email applicative non devono uscire verso destinatari reali.
EMAIL_DELIVERY_MODE=log
EMAIL_FROM=staging@example.org
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_POOL=false
SMTP_MAX_CONNECTIONS=1
SMTP_MAX_MESSAGES=10
CRON_SECRET=

# Variabili usate soltanto dallo script locale delle migration remote.
SERVER_SSH_HOST=
SERVER_SSH_PORT=22
SERVER_SSH_USER=root
SERVER_SSH_KEY=/absolute/path/to/the/staging/ssh/key
SUPABASE_COOLIFY_STACK_ID=
SUPABASE_DB_CONTAINER=
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
