[Unit]
Description=Process Iscrizioni Pace email queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/curl --config /etc/iscrizioni-pace/email-cron.conf
TimeoutStartSec=290
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
