NEXT_PUBLIC_SUPABASE_URL=https://iscrizioni-supabase.stefano-orlando.it
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=https://iscrizioni-supabase.stefano-orlando.it
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Consigliato: segreto server-side stabile per cifrare i token QR recuperabili.
QR_TOKEN_ENCRYPTION_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

EMAIL_FROM=registrationspeace@santegidio.org
EMAIL_USER=registrationspeace@santegidio.org
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Pool SMTP condiviso per istanza serverless. Intervalli validi:
# SMTP_MAX_CONNECTIONS 1-10, SMTP_MAX_MESSAGES 1-1000.
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100
# Usa "log" in sviluppo per stampare le email in console senza inviarle.
EMAIL_DELIVERY_MODE=smtp
# Segreto server-side usato da Vercel Cron per la coda campagne giornaliera.
CRON_SECRET=

# Alias supportato in locale per Gmail Workspace.
GMAIL_APP_PASSWORD=

# In produzione usare:
# NEXT_PUBLIC_APP_URL=https://registrationspeace.santegidio.org
# APP_URL=https://registrationspeace.santegidio.org
# PUBLIC_SITE_URL=https://registrationspeace.santegidio.org
